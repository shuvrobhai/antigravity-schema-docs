{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://antigravity.google/schemas/v1/hooks.schema.json",
  "title": "HooksConfigSchema",
  "description": "Google Antigravity Lifecycle Hooks configuration schema (hooks.json).",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Whether this hook group is active."
      },
      "PreToolUse": {
        "$ref": "#/$defs/eventMatchers",
        "description": "Interceptors triggered before tool execution."
      },
      "PostToolUse": {
        "$ref": "#/$defs/eventMatchers",
        "description": "Interceptors triggered after tool execution completes."
      },
      "PreInvocation": {
        "$ref": "#/$defs/eventMatchers",
        "description": "Interceptors triggered before model API invocation."
      },
      "PostInvocation": {
        "$ref": "#/$defs/eventMatchers",
        "description": "Interceptors triggered after model API response."
      },
      "Stop": {
        "$ref": "#/$defs/eventMatchers",
        "description": "Interceptors triggered when agent execution halts."
      }
    }
  },
  "$defs": {
    "eventMatchers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "matcher": {
            "type": "string",
            "description": "Tool name pattern or regex (e.g., 'run_command', 'browser_.*', '*')."
          },
          "hooks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["command"],
                  "default": "command",
                  "description": "Hook runner type."
                },
                "command": {
                  "type": "string",
                  "description": "Shell script or binary executable command path."
                },
                "timeout": {
                  "type": "integer",
                  "default": 30,
                  "description": "Execution timeout limit in seconds."
                }
              },
              "required": ["command"]
            }
          }
        },
        "required": ["hooks"]
      }
    }
  }
}
